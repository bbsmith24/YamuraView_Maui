<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YamuraView.LogViewerPage"
             Title="Log">

    <Grid Padding="12" RowDefinitions="*,Auto" RowSpacing="8">

        <Editor Grid.Row="0"
                x:Name="LogEditor"
                IsReadOnly="True"
                FontFamily="Consolas"
                FontSize="12" />

        <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End">
            <Button Text="Refresh" Clicked="OnRefreshClicked" />
            <Button Text="Close" Clicked="OnCloseClicked" />
        </HorizontalStackLayout>
    </Grid>

</ContentPage>
