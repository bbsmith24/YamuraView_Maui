<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>YamuraView</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- App version - stamped into the exe's file properties (FileVersion/ProductVersion)
		     and read back at runtime by AppVersion for the About box. Bump major/minor here.
		     VersionStatus "beta" marks a beta build - make it empty for a release build.
		     The build number lives in buildnumber.txt and is bumped automatically at the
		     start of every full Release-configuration build (see BumpBuildNumberForRelease
		     below); Debug builds reuse the current number. -->
		<VersionMajor>1</VersionMajor>
		<VersionMinor>0</VersionMinor>
		<VersionStatus>beta</VersionStatus>
		<VersionBuildNumber>0</VersionBuildNumber>
		<VersionBuildNumber Condition="Exists('$(MSBuildProjectDirectory)\buildnumber.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\buildnumber.txt').Trim())</VersionBuildNumber>
		<Version>$(VersionMajor).$(VersionMinor).$(VersionBuildNumber)</Version>
		<Version Condition="'$(VersionStatus)' != ''">$(Version)-$(VersionStatus)</Version>
		<!-- MAUI's targets replace InformationalVersion (the exe's ProductVersion) with the
		     suffix-less ApplicationDisplayVersion unless it's pinned to Version explicitly -->
		<InformationalVersion>$(Version)</InformationalVersion>
		<Product>YamuraView</Product>
		<Company>Yamura Electronics</Company>
		<!-- keep ProductVersion a clean "1.0.0-beta" instead of appending a source hash -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<!-- Display name -->
		<ApplicationTitle>YamuraView</ApplicationTitle>

		<!-- App Identifier (Android package name - permanent app identity, don't change
		     after distributing or updates stop working) -->
		<ApplicationId>com.yamuraelectronics.yamuraview</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>$(VersionMajor).$(VersionMinor).$(VersionBuildNumber)</ApplicationDisplayVersion>
		<!-- Android versionCode (also the 4th part of the MSIX version) - tied to the
		     auto-bumped build number so every release is a higher version than the last and
		     installs as an update; floored at 1 because Android rejects versionCode 0 -->
		<ApplicationVersion>$(VersionBuildNumber)</ApplicationVersion>
		<ApplicationVersion Condition="'$(VersionBuildNumber)' == '0'">1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Mac Catalyst builds are signed ad-hoc with no entitlements at all by default, which
	     breaks the "Open" button: without com.apple.security.files.user-selected.read-write
	     the file picker presents but its panel is never created, so nothing appears on screen
	     and the picker task never completes - the button just looks dead. This applies to
	     Debug runs and to the unsigned universal .app alike, so default both to the
	     sandbox-free entitlements file.
	     The App Store (.pkg) and Developer ID publish commands in BUILDING-iOS-Mac.md pass
	     -p:CodesignEntitlements=...\Entitlements.plist on the command line, and a global
	     property set there overrides this default - so those builds still get App Sandbox. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<EnableCodeSigning>true</EnableCodeSigning>
		<CodesignEntitlements>Platforms\MacCatalyst\Entitlements.Unsandboxed.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon - Japanese flag: white background layer, red disc foreground -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\YamuraView.Core\YamuraView.Core.csproj" />
	</ItemGroup>

	<!-- Bumps buildnumber.txt at the start of every full Release build, before the
	     per-platform inner builds evaluate the version - so the build being made already
	     carries the new number, every platform gets the same one, and buildnumber.txt always
	     equals the most recent Release build's number (a later per-platform publish with -f
	     reuses it rather than bumping again, since -f skips this outer-build hook). -->
	<Target Name="BumpBuildNumberForRelease"
	        BeforeTargets="DispatchToInnerBuilds"
	        Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<NextVersionBuildNumber>$([MSBuild]::Add($(VersionBuildNumber), 1))</NextVersionBuildNumber>
		</PropertyGroup>
		<WriteLinesToFile File="$(MSBuildProjectDirectory)\buildnumber.txt"
		                  Lines="$(NextVersionBuildNumber)"
		                  Overwrite="true" />
		<Message Importance="high" Text="Release build: bumped build number to $(VersionMajor).$(VersionMinor).$(NextVersionBuildNumber)" />
	</Target>

</Project>
