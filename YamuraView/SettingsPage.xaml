<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YamuraView.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="Config File Path" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="ConfigPathEntry" />
                <Button Grid.Column="1" Text="Browse..." Clicked="OnBrowseConfigClicked" />
            </Grid>

            <Label Text="Autoload Folder" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="AutoloadFolderEntry" />
                <Button Grid.Column="1" Text="Browse..." Clicked="OnBrowseAutoloadFolderClicked" />
            </Grid>

            <Label Text="Run Colors" FontAttributes="Bold" />
            <FlexLayout x:Name="ColorSwatchLayout" Wrap="Wrap" JustifyContent="Start" />

            <Label Text="Chart Display" FontAttributes="Bold" />
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="Strip Chart" VerticalOptions="Center" />
                <Picker Grid.Row="0" Grid.Column="1" x:Name="StripChartDisplayModePicker" WidthRequest="140">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Line</x:String>
                            <x:String>Point</x:String>
                            <x:String>Line + Points</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                <Label Grid.Row="1" Grid.Column="0" Text="Track Map" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1" x:Name="TrackMapDisplayModePicker" WidthRequest="140">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Line</x:String>
                            <x:String>Point</x:String>
                            <x:String>Line + Points</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                <Label Grid.Row="2" Grid.Column="0" Text="Track Map Grid Spacing" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                    <Entry x:Name="TrackMapGridSpacingEntry" WidthRequest="66" Keyboard="Numeric" />
                    <Picker x:Name="TrackMapGridUnitPicker" WidthRequest="90">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Feet</x:String>
                                <x:String>Meters</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </HorizontalStackLayout>
                <Label Grid.Row="3" Grid.Column="0" Text="Traction Circle" VerticalOptions="Center" />
                <Picker Grid.Row="3" Grid.Column="1" x:Name="TractionCircleDisplayModePicker" WidthRequest="140">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Line</x:String>
                            <x:String>Point</x:String>
                            <x:String>Line + Points</x:String>
                            <x:String>Cursor Only</x:String>
                            <x:String>Cursor Trail</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                <Label Grid.Row="4" Grid.Column="0" Text="Cursor Trail Points" VerticalOptions="Center" />
                <Entry Grid.Row="4" Grid.Column="1" x:Name="TractionCircleTrailPointsEntry" WidthRequest="140" Keyboard="Numeric" />
            </Grid>

            <Label Text="Track Map Lines on Strip Chart" FontAttributes="Bold" />
            <Label Text="Show the loaded track map's start/finish/sector crossings as vertical lines on the Strip Chart." FontSize="12" />
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="Show Lines" VerticalOptions="Center" />
                <Switch Grid.Row="0" Grid.Column="1" x:Name="TrackMapLinesSwitch" HorizontalOptions="Start" />
                <Label Grid.Row="1" Grid.Column="0" Text="Start Color" VerticalOptions="Center" />
                <Button Grid.Row="1" Grid.Column="1" x:Name="TrackMapStartColorSwatch" WidthRequest="80" HeightRequest="34" BorderColor="Gray" BorderWidth="1" Clicked="OnTrackMapStartColorClicked" />
                <Label Grid.Row="2" Grid.Column="0" Text="Sector Color" VerticalOptions="Center" />
                <Button Grid.Row="2" Grid.Column="1" x:Name="TrackMapSectorColorSwatch" WidthRequest="80" HeightRequest="34" BorderColor="Gray" BorderWidth="1" Clicked="OnTrackMapSectorColorClicked" />
                <Label Grid.Row="3" Grid.Column="0" Text="Finish Color" VerticalOptions="Center" />
                <Button Grid.Row="3" Grid.Column="1" x:Name="TrackMapFinishColorSwatch" WidthRequest="80" HeightRequest="34" BorderColor="Gray" BorderWidth="1" Clicked="OnTrackMapFinishColorClicked" />
                <Label Grid.Row="4" Grid.Column="0" Text="Line Thickness" VerticalOptions="Center" />
                <Entry Grid.Row="4" Grid.Column="1" x:Name="TrackMapLineWidthEntry" WidthRequest="140" Keyboard="Numeric" />
            </Grid>

            <Label Text="Track Map Marks" FontAttributes="Bold" />
            <Label Text="Point-of-interest markers (cones, apexes) placed during a track walk, drawn as squares on the track map." FontSize="12" />
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="Mark Color" VerticalOptions="Center" />
                <Button Grid.Row="0" Grid.Column="1" x:Name="TrackMapMarkColorSwatch" WidthRequest="80" HeightRequest="34" BorderColor="Gray" BorderWidth="1" Clicked="OnTrackMapMarkColorClicked" />
            </Grid>

            <Label Text="Total G" FontAttributes="Bold" />
            <Label Text="Channels combined into the calculated TotalG channel, sqrt(latG² + longG²), added when a log file is read. Changing them recalculates TotalG for loaded runs." FontSize="12" />
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="Lateral G" VerticalOptions="Center" />
                <Picker Grid.Row="0" Grid.Column="1" x:Name="LatGChannelPicker" WidthRequest="140" />
                <Label Grid.Row="1" Grid.Column="0" Text="Longitudinal G" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1" x:Name="LongGChannelPicker" WidthRequest="140" />
            </Grid>

            <Label Text="Channel Filters" FontAttributes="Bold" />
            <Label Text="Display-only smoothing per channel (e.g. vibration noise on G channels) - the logged data is unchanged. Window is in samples, centered on each point." FontSize="12" />
            <VerticalStackLayout x:Name="ChannelFilterLayout" Spacing="4" />

            <Label Text="Remove Runs" FontAttributes="Bold" />
            <Label Text="Check the runs to remove - they're unloaded when you Save (reload the log file to get one back)." FontSize="12" />
            <VerticalStackLayout x:Name="RunRemovalLayout" Spacing="4" />

            <Label Text="Export Data" FontAttributes="Bold" />
            <Label Text="Write each checked run to a CSV or TSV file next to its log file (same name, new extension). The first row is the channel names, starting with Time." FontSize="12" />
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="Format" VerticalOptions="Center" />
                <Picker Grid.Row="0" Grid.Column="1" x:Name="ExportFormatPicker" WidthRequest="140">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>CSV</x:String>
                            <x:String>TSV</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Grid>
            <VerticalStackLayout x:Name="ExportRunLayout" Spacing="4" />
            <Button Text="Export" Clicked="OnExportClicked" HorizontalOptions="Start" />

            <Label Text="Log" FontAttributes="Bold" />
            <Button Text="View Log" Clicked="OnViewLogClicked" HorizontalOptions="Start" />

            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                <Button Text="Cancel" Clicked="OnCancelClicked" />
                <Button Text="Save" Clicked="OnSaveClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
