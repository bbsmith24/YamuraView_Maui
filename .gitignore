# .NET / MAUI build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/

# VS Code — keep shared build tasks, ignore local-only files
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json

# MAUI / mobile packaged output
*.apk
*.aab
*.ipa
*.app/
*.pkg

# NuGet
*.nupkg
project.lock.json
*.nuget.props
*.nuget.targets

# OS cruft
.DS_Store
Thumbs.db

# Signing keys / secrets — never commit these (distribute out-of-band, keep backed up)
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision

# Local tooling config
.claude/
